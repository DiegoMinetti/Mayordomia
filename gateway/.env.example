# Mayordomía Gateway — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# Comma-separated origins allowed by CORS. In production, set this to your
# public domain. For local dev, leave it commented to allow any origin.
# ALLOWED_ORIGINS=https://mayordomia.example.com

# --- Google Sheets ---
# ID of the spreadsheet that holds all the data (Organizations, Users, Sites, etc.).
# Find it in the spreadsheet URL: /d/<THIS_PART>/edit
SPREADSHEET_ID=
# Path to the Service Account JSON key. In docker-compose on the Pi this is
# /run/secrets/sa-key.json (read-only mount from ./secrets/).
# For local dev, point to wherever you saved the key.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/sa-key.json

# --- Google Calendar (optional, like Apps Script) ---
# CALENDAR_ID=

# --- Resend (optional, like Apps Script) ---
# RESEND_API_KEY=
# RESEND_FROM=

# --- Public token pepper (used by PublicRequests for HMAC of op tokens) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_TOKEN_PEPPER=

# --- Rate limiting (per-IP, in-memory; replace with Redis if you scale) ---
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=100
