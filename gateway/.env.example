# Mayordomía Gateway — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# Comma-separated origins allowed by CORS. In production, set this to your
# public domain. For local dev, leave it commented to allow any origin.
# ALLOWED_ORIGINS=https://mayordomia.example.com

# --- Local SQLite database (PR 1: replacing Google Sheets as the store) ---
# Path to the .db file. In docker-compose on the Pi, this lives in the
# /mayordomia/data volume (e.g. /mayordomia/data/mayordomia.db). For local
# dev, omit to use ./data/mayordomia-<env>.db. Use :memory: for ephemeral tests.
DB_PATH=/mayordomia/data/mayordomia.db

# --- Google Sheets (deprecated — kept during the Sheets→SQLite migration) ---
# These vars are read by the Sheets client in `src/sheets/client.ts` and will
# be removed in PR 2. Leave blank to disable the Sheets probe in health.
# Find the spreadsheet ID in its URL: /d/<THIS_PART>/edit
# SPREADSHEET_ID=
# Path to the Service Account JSON key. In docker-compose on the Pi this is
# /run/secrets/sa-key.json (read-only mount from ./secrets/).
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/sa-key.json

# --- Google Calendar (optional, like Apps Script) ---
# CALENDAR_ID=

# --- Resend (optional, like Apps Script) ---
# RESEND_API_KEY=
# RESEND_FROM=

# --- Public token pepper (used by PublicRequests for HMAC of op tokens) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_TOKEN_PEPPER=

# --- Rate limiting (per-IP, in-memory; replace with Redis if you scale) ---
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=100
