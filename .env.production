# Defaults for production builds — committed, no secrets.
# Override per-build with .env.production.local (gitignored) or shell env vars.
#
# This file gives `npm run build` (mode=production) a baseline so it doesn't
# fall back to /Mayordomia/ asset paths or fail to enable the login button.

VITE_BASE_PATH=/
VITE_APPS_SCRIPT_URL=/api
VITE_USE_MOCK_PUBLIC=false
VITE_GOOGLE_CLIENT_ID=
