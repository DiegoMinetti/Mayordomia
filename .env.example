# Mayordomía — environment variables
#
# Two scopes:
#   1. Frontend (Vite, build-time): vars prefixed with VITE_ get baked into
#      the JS bundle. Read by vite.config.ts and src/main.tsx.
#   2. Gateway (Node, runtime): vars read by /mayordomia/.env on the Pi and
#      passed to the api container via docker-compose.
#
# Copy this file to one of:
#   - .env.local            (all modes, gitignored)        ← typical dev
#   - .env.production.local (production builds, gitignored) ← deploys
#   - .env                  (committed, defaults only — never put secrets here)
#
# Then fill in the values you have. Build with `npm run build` and the bundle
# will embed them.

# ────────────────────────────────────────────────────────────────────────────
# Frontend (Vite build-time, baked into dist/assets/*)
# ────────────────────────────────────────────────────────────────────────────

# Google OAuth Web Client ID (https://console.cloud.google.com/apis/credentials).
# Required for the "Iniciar sesión con Google" button to render. Format:
#   <numbers>-<letters>...apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# URL prefix where the gateway Node lives, AS SEEN FROM THE BROWSER.
# - Self-hosted on mayordomia.fewlines.com.ar via Pi:    /api
#   (nginx proxies /api/* → mayordomia-api:3000 in the same docker network)
# - Hosted on Apps Script (legacy/fallback):             https://script.google.com/macros/s/<id>/exec
# Leave empty to force mock mode (frontend ships with deterministic fake data).
VITE_APPS_SCRIPT_URL=/api

# Base path for asset URLs in the bundle.
# - Deploy to mayordomia.fewlines.com.ar (own domain):   /
# - Deploy to GH Pages at /Mayordomia/ (legacy):         /Mayordomia/
# vite.config.ts reads this; defaults to /Mayordomia/ when unset.
VITE_BASE_PATH=/

# E2E test flag — DO NOT set true in production.
VITE_USE_MOCK_PUBLIC=false

# ────────────────────────────────────────────────────────────────────────────
# Gateway (Node runtime — read by /mayordomia/.env on the Pi, NOT here)
# ────────────────────────────────────────────────────────────────────────────
# These are NOT read by Vite. They live in /mayordomia/.env on the Raspberry
# Pi and are passed to the `api` container via docker-compose. Listed here as
# documentation only — copy them to the Pi-side file when deploying.
#
# SPREADSHEET_ID=                                  # required: Sheets DB id
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/sa-key.json
# ALLOWED_ORIGINS=https://mayordomia.fewlines.com.ar
# NODE_ENV=production
# PORT=3000
# LOG_LEVEL=info
# CALENDAR_ID=                                     # optional
# RESEND_API_KEY=                                   # optional
# RESEND_FROM=                                      # optional
# PUBLIC_TOKEN_PEPPER=                              # optional; required for public tokens
